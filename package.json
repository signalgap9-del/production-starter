{
  "name": "production-starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "lint": "node --check src/server.mjs && node --check test/server.test.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "build": "node -e \"console.log('build check ok')\"",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "22.15.3",
    "typescript": "7.0.2"
  }
}
